let mapBuilt = false;
function renderMap(){
  if(mapBuilt) return;
  mapBuilt = true;
  const canvas = document.getElementById('map-canvas');
  const svg = document.getElementById('map-svg');
  svg.setAttribute('viewBox','0 0 2260 980');

  const byId = {};
  nodes.forEach(n => byId[n.id] = n);

  // draw edges
  edges.forEach(([a,b,type])=>{
    const na = byId[a], nb = byId[b];
    if(!na || !nb) return;
    const line = document.createElementNS('http://www.w3.org/2000/svg','line');
    line.setAttribute('x1', na.x); line.setAttribute('y1', na.y);
    line.setAttribute('x2', nb.x); line.setAttribute('y2', nb.y);
    line.setAttribute('stroke', COLORS[type]);
    line.setAttribute('stroke-width', type==='romance' ? 2.4 : type==='family' ? 2.2 : 1.4);
    if(type==='friend' || type==='mentor' || type==='poly'){ line.setAttribute('stroke-dasharray','5,5'); }
    line.classList.add('edge');
    line.dataset.a = a; line.dataset.b = b;
    svg.appendChild(line);
  });

  // draw nodes
  nodes.forEach(n=>{
    const div = document.createElement('div');
    div.className = 'node ' + n.gen + (n.notBriar ? ' notbriar' : '');
    div.style.left = n.x + 'px';
    div.style.top = n.y + 'px';
    div.dataset.id = n.id;
    let inner = `<div class="n-name">${n.name}</div>`;
    if(n.book && n.book !== '—'){ inner += `<div class="n-book">${n.book}</div>`; }
    if(n.notBriar){ inner += `<div class="n-flag">Not Briar U</div>`; }
    div.innerHTML = inner;
    div.addEventListener('click', ()=> focusNode(n.id));
    canvas.appendChild(div);
  });

  canvas.addEventListener('click', (e)=>{
    if(e.target === canvas || e.target === svg){ clearFocus(); }
  });
}

function clearFocus(){
  document.querySelectorAll('.node').forEach(el=> el.classList.remove('dim','lit'));
  document.querySelectorAll('.edge').forEach(el=> el.classList.remove('dim','lit'));
}

function focusNode(id){
  const connected = new Set([id]);
  const litEdges = [];
  edges.forEach(([a,b])=>{
    if(a===id) { connected.add(b); }
    if(b===id) { connected.add(a); }
  });
  document.querySelectorAll('.node').forEach(el=>{
    const nid = el.dataset.id;
    el.classList.remove('dim','lit');
    if(!nid) return;
    if(connected.has(nid)){ el.classList.add('lit'); }
    else { el.classList.add('dim'); }
  });
  document.querySelectorAll('.edge').forEach(el=>{
    el.classList.remove('dim','lit');
    if(el.dataset.a === id || el.dataset.b === id){ el.classList.add('lit'); }
    else { el.classList.add('dim'); }
  });
}

/* ===================== FAMILY TREE CLICK-TO-FOCUS ===================== */
let familyFocused = null;

function familyFocus(id){
  const connected = new Set([id]);
  edges.forEach(([a,b])=>{
    if(a===id) connected.add(b);
    if(b===id) connected.add(a);
  });
  document.querySelectorAll('.family-block .card[data-id]').forEach(el=>{
    const cid = el.dataset.id;
    el.classList.remove('dim','lit');
    if(connected.has(cid)){ el.classList.add('lit'); }
    else { el.classList.add('dim'); }
  });
}
function clearFamilyFocus(){
  document.querySelectorAll('.family-block .card[data-id]').forEach(el=> el.classList.remove('dim','lit'));
  familyFocused = null;
}
document.querySelectorAll('.family-block .card[data-id]').forEach(card=>{
  card.addEventListener('click', (e)=>{
    e.stopPropagation();
    const id = card.dataset.id;
    if(familyFocused === id){ clearFamilyFocus(); }
    else { familyFocus(id); familyFocused = id; }
  });
});
document.getElementById('families').addEventListener('click', clearFamilyFocus);

/* ===================== GLOBAL SEARCH ===================== */
const searchInput = document.getElementById('global-search');
function performSearch(){
  const q = searchInput.value.trim().toLowerCase();
  const targets = document.querySelectorAll('.family-block .card[data-id], .friend-groups .bubble, .node');
  if(!q){
    targets.forEach(el=> el.classList.remove('dim','lit'));
    return;
  }
  targets.forEach(el=>{
    const text = el.textContent.toLowerCase();
    el.classList.remove('dim','lit');
    if(text.includes(q)){ el.classList.add('lit'); }
    else { el.classList.add('dim'); }
  });
}
searchInput.addEventListener('input', performSearch);
searchInput.addEventListener('keydown', (e)=>{
  if(e.key === 'Escape'){ searchInput.value=''; performSearch(); searchInput.blur(); }
});

