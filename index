<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Briar U Universe — Family Tree &amp; Timeline</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,500;9..144,600;9..144,700&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0e1b2c;
    --ink-2:#16263c;
    --cream:#f3ede0;
    --cream-2:#e9e0cc;
    --gold:#c9a24b;
    --gold-2:#e4c877;
    --maroon:#7c2c2c;
    --maroon-2:#9c3d3d;
    --ice:#8fb8c9;
    --line: rgba(243,237,224,0.16);
    --shadow: 0 18px 40px rgba(0,0,0,0.35);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(1200px 700px at 15% -10%, #1a2c46 0%, transparent 60%),
      radial-gradient(1000px 600px at 110% 10%, #24140f 0%, transparent 55%),
      var(--ink);
    color:var(--cream);
    font-family:'Public Sans', sans-serif;
    min-height:100vh;
  }
  ::selection{ background:var(--gold); color:var(--ink); }

  /* ---------- Header ---------- */
  header{
    padding:56px 6vw 28px;
    position:relative;
    border-bottom:1px solid var(--line);
  }
  .eyebrow{
    font-family:'Public Sans',sans-serif;
    letter-spacing:.28em;
    text-transform:uppercase;
    font-size:11px;
    color:var(--gold-2);
    font-weight:700;
    display:flex; align-items:center; gap:10px;
  }
  .eyebrow::before{
    content:"";
    width:26px; height:1px; background:var(--gold-2);
    display:inline-block;
  }
  h1{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:clamp(2.2rem, 5vw, 4rem);
    margin:14px 0 10px;
    letter-spacing:-0.01em;
    line-height:1.02;
  }
  h1 em{ font-style:italic; color:var(--gold-2); font-weight:500;}
  header p.sub{
    max-width:640px;
    color:#cfd7e2;
    font-size:15.5px;
    line-height:1.6;
    margin:0 0 6px;
  }
  .crest-row{
    position:absolute; right:6vw; top:50px;
    display:flex; gap:10px;
  }
  .crest{
    width:54px;height:54px;border-radius:50%;
    border:1.5px solid var(--gold);
    display:flex;align-items:center;justify-content:center;
    font-family:'Fraunces',serif; font-weight:600; font-size:12px;
    color:var(--gold-2);
    background:rgba(124,44,44,0.18);
  }

  /* ---------- Tabs ---------- */
  nav.tabs{
    position:sticky; top:0; z-index:50;
    display:flex; gap:2px; flex-wrap:wrap; align-items:center;
    padding:14px 6vw;
    background:rgba(14,27,44,0.92);
    backdrop-filter: blur(10px);
    border-bottom:1px solid var(--line);
  }
  .search-wrap{ margin-left:auto; position:relative; }
  #global-search{
    font-family:'Public Sans',sans-serif; font-size:13px;
    background:rgba(243,237,224,0.06); border:1px solid var(--line);
    color:var(--cream); border-radius:999px; padding:9px 16px 9px 34px;
    width:190px; transition:.2s ease;
  }
  #global-search:focus{ outline:none; border-color:var(--gold-2); width:230px; background:rgba(243,237,224,0.1); }
  #global-search::placeholder{ color:#8590a3; }
  .search-wrap::before{
    content:"⌕"; position:absolute; left:13px; top:50%; transform:translateY(-50%);
    color:#8590a3; font-size:14px; pointer-events:none;
  }
  .spoiler-toggle{
    display:flex; align-items:center; gap:7px; margin-left:14px;
    font-size:12px; color:#b9c3d2; cursor:pointer; user-select:none;
  }
  .spoiler-toggle input{ accent-color:var(--gold-2); cursor:pointer; width:14px; height:14px;}

  /* spoiler blur — applied to next-gen (Campus Diaries) content */
  body.hide-spoilers .card.gen2,
  body.hide-spoilers .bubble.nextgen,
  body.hide-spoilers .node.gen2,
  body.hide-spoilers .book.gen2,
  body.hide-spoilers .tl-era.gen2{
    filter: blur(6px);
    transition: filter .18s ease;
  }
  body.hide-spoilers .card.gen2:hover,
  body.hide-spoilers .bubble.nextgen:hover,
  body.hide-spoilers .node.gen2:hover,
  body.hide-spoilers .book.gen2:hover,
  body.hide-spoilers .tl-era.gen2:hover{
    filter: blur(0);
  }
  nav.tabs button{
    font-family:'Public Sans',sans-serif;
    font-weight:600;
    font-size:13.5px;
    letter-spacing:.02em;
    color:#b9c3d2;
    background:transparent;
    border:1px solid transparent;
    padding:9px 16px;
    border-radius:999px;
    cursor:pointer;
    transition:.18s ease;
  }
  nav.tabs button:hover{ color:var(--cream); border-color:var(--line);}
  nav.tabs button.active{
    color:var(--ink);
    background:var(--gold-2);
    border-color:var(--gold-2);
  }
  nav.tabs button:focus-visible{ outline:2px solid var(--ice); outline-offset:2px; }

  main{ padding:40px 6vw 100px; max-width:1400px; margin:0 auto; }
  section.view{ display:none; animation:fade .35s ease; }
  section.view.active{ display:block; }
  @keyframes fade{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;} }

  .view-head{ margin-bottom:30px; max-width:720px; }
  .view-head h2{
    font-family:'Fraunces',serif; font-weight:600; font-size:clamp(1.6rem,3vw,2.3rem);
    margin:0 0 8px;
  }
  .view-head p{ color:#c3cddb; font-size:14.5px; line-height:1.6; margin:0;}

  /* ---------- Legend ---------- */
  .legend{ display:flex; gap:18px; flex-wrap:wrap; margin:18px 0 6px; font-size:12.5px; color:#b9c3d2;}
  .legend span{ display:inline-flex; align-items:center; gap:7px;}
  .swatch{ width:13px; height:13px; border-radius:3px; display:inline-block;}

  /* ============ FAMILY TREES ============ */
  .family-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:34px; }
  .family-block{
    background:linear-gradient(180deg, rgba(233,224,204,0.04), rgba(233,224,204,0.01));
    border:1px solid var(--line);
    border-radius:14px;
    padding:26px 22px 30px;
  }
  .family-name{
    font-family:'Fraunces',serif; font-size:1.15rem; font-weight:600;
    color:var(--gold-2); margin:0 0 4px;
    display:flex; align-items:center; gap:8px;
  }
  .family-name small{ font-family:'Public Sans',sans-serif; font-weight:500; font-size:11px; color:#8a95a8; }

  .tree{ margin-top:20px; }
  .gen0{
    text-align:center; padding:10px 12px; border:1px dashed var(--line);
    border-radius:10px; font-size:12.5px; color:#9fa9ba; margin-bottom:4px;
  }
  .trunk{ width:1px; height:20px; background:var(--line); margin:0 auto; }
  .couple-row{ display:flex; align-items:stretch; justify-content:center; gap:0; }
  .card{
    background:var(--cream);
    color:var(--ink);
    border-radius:10px;
    padding:12px 14px;
    min-width:150px;
    box-shadow:var(--shadow);
    position:relative;
    border-left:4px solid var(--maroon-2);
  }
  .card.protag{ border-left-color:var(--gold); }
  .card .nm{ font-family:'Fraunces',serif; font-weight:600; font-size:14.5px; line-height:1.15; }
  .card .role{ font-size:10.5px; color:#6b5f47; text-transform:uppercase; letter-spacing:.04em; margin-top:3px;}
  .card .bio{ font-size:11px; color:#5c5646; font-style:italic; line-height:1.4; margin-top:6px; max-width:190px; }
  .card .bk{
    display:inline-block; margin-top:7px; font-size:10.5px; font-weight:700;
    background:var(--maroon); color:var(--cream-2); padding:3px 8px; border-radius:5px;
  }
  .card .tbd{
    display:inline-block; margin-top:7px; font-size:9.5px; font-weight:700;
    letter-spacing:.03em; text-transform:uppercase;
    background:transparent; color:#8a8060; padding:3px 8px; border-radius:5px;
    border:1px dashed #b5a97e;
  }
  .card{ cursor:pointer; transition:opacity .18s ease, box-shadow .18s ease; }
  .card.dim{ opacity:.22; }
  .card.lit{ box-shadow:0 0 0 2px var(--gold-2), var(--shadow); }
  .bubble{ transition:opacity .18s ease, box-shadow .18s ease; }
  .bubble.dim{ opacity:.2; }
  .bubble.lit{ box-shadow:0 0 0 2px var(--gold-2), var(--shadow); }
  .card .offbriar, .agebadge + .offbriar-inline{
    display:inline-block; margin-top:7px; font-size:9.5px; font-weight:700;
    letter-spacing:.03em; text-transform:uppercase;
    background:repeating-linear-gradient(135deg, #5b5142, #5b5142 4px, #6b6047 4px, #6b6047 8px);
    color:#f0e9d8; padding:3px 8px; border-radius:5px;
  }
  .ring{
    align-self:center; padding:0 10px; color:var(--gold-2); font-size:16px;
  }
  .children-wrap{ display:flex; flex-direction:column; align-items:center; }
  .children{ display:flex; gap:16px; justify-content:center; flex-wrap:wrap; margin-top:0; position:relative; padding-top:18px;}
  .children::before{
    content:""; position:absolute; top:0; left:50%; width:1px; height:18px;
    background:var(--line); transform:translateX(-50%);
  }
  .child{ display:flex; flex-direction:column; align-items:center; }
  .child .branch{ width:1px; height:14px; background:var(--line);}

  /* ============ FRIEND GROUPS ============ */
  .friend-groups{ display:flex; flex-direction:column; gap:48px; }
  .fg{
    border:1px solid var(--line); border-radius:16px; padding:30px 26px;
    background:linear-gradient(180deg, rgba(124,44,44,0.08), rgba(124,44,44,0.01));
  }
  .fg-title{ display:flex; align-items:baseline; gap:12px; margin-bottom:6px; flex-wrap:wrap;}
  .fg-title h3{ font-family:'Fraunces',serif; font-size:1.3rem; margin:0; color:var(--gold-2); font-weight:600;}
  .fg-title span{ font-size:12px; color:#9aa5b6; }
  .fg-note{ font-size:13.5px; color:#c3cddb; max-width:640px; margin:6px 0 20px; line-height:1.55;}
  .cluster{ display:flex; flex-wrap:wrap; gap:14px; }
  .bubble{
    background:var(--cream); color:var(--ink); border-radius:999px;
    padding:9px 16px; font-size:13px; font-weight:600; font-family:'Public Sans',sans-serif;
    box-shadow:var(--shadow); position:relative; cursor:default;
    border:1.5px solid transparent;
  }
  .bubble.hockey{ border-color:var(--maroon-2); }
  .bubble.girls{ border-color:var(--ice); }
  .bubble.nextgen{ border-color:var(--gold); }
  .bubble small{ display:block; font-weight:500; font-size:10.5px; color:#6b6250; margin-top:2px;}
  .link-note{
    font-size:12.5px; color:#a9b3c4; margin-top:16px; padding-top:14px;
    border-top:1px dashed var(--line); line-height:1.7;
  }
  .link-note b{ color:var(--gold-2); font-weight:700; }

  /* ============ CONNECTIONS MAP ============ */
  .map-scroll{
    overflow-x:auto; overflow-y:hidden;
    border:1px solid var(--line); border-radius:16px;
    background:linear-gradient(180deg, rgba(233,224,204,0.03), rgba(233,224,204,0.01));
    padding:10px;
  }
  .map-canvas{ position:relative; width:2260px; height:980px; }
  #map-svg{ position:absolute; inset:0; width:100%; height:100%; overflow:visible; }
  .node{
    position:absolute; transform:translate(-50%,-50%);
    background:var(--cream); color:var(--ink); border-radius:9px;
    padding:7px 11px; min-width:108px; max-width:150px; text-align:center;
    box-shadow:var(--shadow); cursor:pointer; z-index:2;
    border:2px solid transparent;
    transition:.15s ease;
  }
  .node .n-name{ font-family:'Fraunces',serif; font-weight:600; font-size:12.5px; line-height:1.15;}
  .node .n-book{ font-size:8.5px; color:#7a7259; margin-top:2px; text-transform:uppercase; letter-spacing:.03em;}
  .node.gen0{ background:transparent; border:1px dashed var(--line); color:#b9c3d2; box-shadow:none; padding:5px 10px;}
  .node.gen0 .n-name{ font-size:11px; font-weight:600; color:#b9c3d2;}
  .node.notbriar{
    background:repeating-linear-gradient(135deg, #5b5142, #5b5142 4px, #6b6047 4px, #6b6047 8px);
    color:#f0e9d8;
  }
  .node.notbriar .n-name{ color:#f0e9d8; }
  .node.notbriar .n-flag{ font-size:8.5px; color:#f0e9d8; opacity:.85; text-transform:uppercase; letter-spacing:.03em; margin-top:2px; font-weight:700;}
  .node.dim{ opacity:.18; }
  .node.lit{ border-color:var(--gold-2); z-index:3; }
  .edge{ transition:.15s ease; }
  .edge.dim{ opacity:.06; }
  .edge.lit{ opacity:1 !important; stroke-width:3.2 !important; }

  /* ============ BOOK GUIDE ============ */
  .series-block{ margin-bottom:46px; }
  .series-head{ display:flex; align-items:baseline; gap:14px; margin-bottom:18px; flex-wrap:wrap;}
  .series-head h3{ font-family:'Fraunces',serif; font-size:1.5rem; margin:0; font-weight:600;}
  .series-head .tag{
    font-size:11px; letter-spacing:.06em; text-transform:uppercase; font-weight:700;
    color:var(--ink); background:var(--ice); padding:4px 10px; border-radius:6px;
  }
  .series-head p{ width:100%; color:#c3cddb; font-size:13.5px; margin:2px 0 0; max-width:680px; line-height:1.55;}
  .book-row{ display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px; }
  .book{
    background:var(--cream); color:var(--ink); border-radius:12px; padding:16px 16px 18px;
    box-shadow:var(--shadow); display:flex; flex-direction:column; gap:6px;
    border-top:5px solid var(--gold);
  }
  .book.upcoming{ opacity:.72; border-top-color:#9aa5b6; border-style:dashed; border-top-width:3px;}
  .book .num{ font-size:11px; font-weight:700; color:var(--maroon); letter-spacing:.05em;}
  .book .title{ font-family:'Fraunces',serif; font-weight:600; font-size:16.5px; line-height:1.2;}
  .book .couple{ font-size:12.5px; color:#4a4232; font-weight:600;}
  .book .yr{ font-size:11px; color:#7a7259; margin-top:auto; padding-top:6px;}

  /* ============ TIMELINE ============ */
  .timeline-wrap{ position:relative; padding-left:26px; }
  .timeline-wrap::before{
    content:""; position:absolute; left:6px; top:6px; bottom:6px; width:2px;
    background:linear-gradient(var(--gold), var(--maroon-2), var(--ice));
  }
  .tl-era{ margin-bottom:44px; position:relative; }
  .tl-dot{
    position:absolute; left:-26px; top:4px; width:14px; height:14px; border-radius:50%;
    background:var(--gold-2); border:3px solid var(--ink);
  }
  .tl-era h3{ font-family:'Fraunces',serif; font-size:1.3rem; margin:0 0 4px; color:var(--gold-2);}
  .tl-era .when{ font-size:12px; color:#9aa5b6; margin-bottom:14px;}
  .tl-books{ display:flex; flex-direction:column; gap:10px; }
  .tl-book{
    display:flex; align-items:center; gap:14px; background:rgba(243,237,224,0.05);
    border:1px solid var(--line); border-radius:10px; padding:10px 16px;
  }
  .tl-book .idx{ font-family:'Fraunces',serif; font-weight:600; color:var(--maroon-2); font-size:15px; width:22px;}
  .tl-book .info b{ font-size:14px; }
  .tl-book .info span{ display:block; font-size:12px; color:#a9b3c4; margin-top:2px;}

  footer{
    text-align:center; padding:30px; font-size:11.5px; color:#6d7688;
    border-top:1px solid var(--line);
  }

  @media (max-width:640px){
    .crest-row{ display:none; }
    header{ padding:40px 5vw 22px;}
    main{ padding:30px 5vw 80px;}
  }
</style>
</head>
<body>

<header>
  <div class="crest-row"><div class="crest">BU</div></div>
  <div class="eyebrow">Off&#8209;Campus &middot; Briar U &middot; Campus Diaries</div>
  <h1>The <em>Briar University</em><br>Universe, Mapped</h1>
  <p class="sub">A fan reference tracing three generations of hockey players, their families, their friend groups, and which Elle Kennedy book each one belongs to &mdash; built from the series' own published family tree plus book synopses.</p>
</header>

<nav class="tabs">
  <button data-view="families" class="active">Family Trees</button>
  <button data-view="friends">Friend Groups</button>
  <button data-view="map">Connections Map</button>
  <button data-view="books">Book Guide</button>
  <button data-view="timeline">Timeline</button>
  <div class="search-wrap">
    <input type="text" id="global-search" placeholder="Find a character…" autocomplete="off">
  </div>
  <label class="spoiler-toggle">
    <input type="checkbox" id="spoiler-toggle">
    Hide Campus Diaries spoilers
  </label>
</nav>

<main>

  <!-- ======================= FAMILIES ======================= -->
  <section class="view active" id="families">
    <div class="view-head">
      <h2>Four Families, Three Generations</h2>
      <p>Gold-edged cards are book protagonists; maroon-edged cards are family members who haven't (yet) led their own book. Lines trace parent &rarr; child.</p>
    </div>
    <div class="legend">
      <span><i class="swatch" style="background:var(--gold)"></i> Book protagonist</span>
      <span><i class="swatch" style="background:var(--maroon-2)"></i> Family / supporting character</span>
    </div>

    <div class="family-grid">

      <!-- GRAHAM -->
      <div class="family-block">
        <p class="family-name">The Grahams <small>Off-Campus &rarr; Campus Diaries</small></p>
        <div class="tree">
          <div class="gen0">Phil Graham &amp; Mrs. Graham</div>
          <div class="trunk"></div>
          <div class="couple-row">
            <div data-id="garrett" class="card protag"><div class="nm">Garrett Graham</div><div class="role">Hockey captain</div><div class="bio">Hockey captain who fake-dates a shy music major to make an ex jealous &mdash; and falls for real.</div><span class="bk">THE DEAL</span></div>
            <div class="ring">&#8734;</div>
            <div data-id="hannah" class="card protag"><div class="nm">Hannah Wells</div><div class="role">Music major</div><div class="bio">Quiet music major who strikes a deal: tutoring lessons for a fake relationship.</div><span class="bk">THE DEAL</span></div>
          </div>
          <div class="children-wrap">
            <div class="children">
              <div class="child">
                <div class="branch"></div>
                <div data-id="wyatt" class="card protag gen2"><div class="nm">Wyatt Graham</div><div class="role">Son &middot; hockey</div><div class="bio">Garrett &amp; Hannah's son &mdash; a musician at heart, raised in a house full of hockey.</div><span class="bk">LOVE SONG</span></div>
              </div>
              <div class="child">
                <div class="branch"></div>
                <div data-id="gigi" class="card protag gen2"><div class="nm">Gigi Graham</div><div class="role">Daughter</div><div class="bio">Garrett &amp; Hannah's daughter, following her dad onto the ice as team manager.</div><span class="bk">GRAHAM EFFECT</span></div>
              </div>
            </div>
          </div>
          <div style="text-align:center;margin-top:6px;font-size:12px;color:#9aa5b6;">Gigi marries <b style="color:var(--gold-2)">Luke Ryder</b> (co-captain, her love interest in <i>The Graham Effect</i>)</div>
        </div>
      </div>

      <!-- LOGAN -->
      <div class="family-block">
        <p class="family-name">The Logans <small>Off-Campus &rarr; Campus Diaries</small></p>
        <div class="tree">
          <div class="gen0">Ward Logan &amp; Jean Logan</div>
          <div class="trunk"></div>
          <div class="children-wrap">
            <div class="children" style="padding-top:0;">
              <div class="child">
                <div data-id="jeffrey" class="card"><div class="nm">Jeffrey Logan</div><div class="role">Married Kylie</div><span class="tbd">No book yet</span></div>
              </div>
              <div class="child">
                <div class="couple-row">
                  <div data-id="logan" class="card protag"><div class="nm">John "Logan" Logan</div><div class="role">Hockey player</div><div class="bio">Garrett's best friend and teammate, carrying a bad reputation and a soft spot he won't admit to.</div><span class="bk">THE MISTAKE</span></div>
                  <div class="ring">&#8734;</div>
                  <div data-id="grace" class="card protag"><div class="nm">Grace Ivers</div><div class="role">Photographer</div><div class="bio">Aspiring photographer who's sworn off hockey players &mdash; until Logan won't take no for an answer.</div><span class="bk">THE MISTAKE</span></div>
                </div>
                <div class="children" style="margin-top:14px;">
                  <div class="child">
                    <div class="branch"></div>
                    <div data-id="blake" class="card protag gen2"><div class="nm">Blake Logan</div><div class="role">Son &middot; hockey</div><div class="bio">Logan &amp; Grace's son, Wyatt's best friend and eventually something more.</div><span class="bk">LOVE SONG</span></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div style="text-align:center;margin-top:6px;font-size:12px;color:#9aa5b6;">Blake Logan &amp; Wyatt Graham are the co-leads of <b style="color:var(--gold-2)">Love Song</b></div>
        </div>
      </div>

      <!-- DI LAURENTIS -->
      <div class="family-block" style="grid-column:span 1;">
        <p class="family-name">The Di Laurentis' <small>Off-Campus &rarr; Briar U &rarr; Campus Diaries</small></p>
        <div class="tree">
          <div class="gen0">Peter Di Laurentis &amp; Lori Heyward</div>
          <div class="trunk"></div>
          <div class="children-wrap">
            <div class="children" style="padding-top:0; align-items:flex-start;">
              <div class="child">
                <div data-id="nick" class="card"><div class="nm">Nick Heyward-Di Laurentis</div><div class="role">Sibling</div><span class="tbd">No book yet</span></div>
